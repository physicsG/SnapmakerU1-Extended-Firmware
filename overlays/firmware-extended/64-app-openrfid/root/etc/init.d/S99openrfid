#!/bin/sh

PIDFILE="/var/run/openrfid.pid"
EXTENDED2_CFG="/oem/printer_data/config/extended/extended2.cfg"
API_OVERRIDE_CFG="/tmp/openrfid_api_overrides.cfg"

start() {
    RFID=$(/usr/local/bin/extended-config.py get "$EXTENDED2_CFG" components rfid snapmaker 2>/dev/null)
    DETECT_CONFIG=""
    case "$RFID" in
        openrfid)
            DETECT_CONFIG=/usr/local/share/openrfid/extended/openrfid_u1_vendor.cfg
            ;;

        openrfid-generic)
            DETECT_CONFIG=/usr/local/share/openrfid/extended/openrfid_u1_generic.cfg
            ;;

        *)
            echo "Filament tag detection not set to openrfid or openrfid-generic, not starting."
            return
            ;;
    esac

    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "OpenRFID already running"
        return 0
    fi

    ADDITIONAL_CONFIG=/oem/printer_data/config/extended/openrfid_user.cfg
    if ! test -f "$ADDITIONAL_CONFIG"; then
        ADDITIONAL_CONFIG=""
    fi

    # Pick up additional integration configs dropped in by other overlays
    # (e.g. 68-app-rfid-spools provides openrfid_api.cfg). The base/vendor/
    # generic/user files are excluded here because they are passed
    # explicitly above so their merge order is deterministic.
    EXTRA_CONFIGS=""
    for f in /usr/local/share/openrfid/extended/openrfid_*.cfg; do
        [ -f "$f" ] || continue
        case "$f" in
            */openrfid_u1_base.cfg|*/openrfid_u1_vendor.cfg|*/openrfid_u1_generic.cfg|*/openrfid_user.cfg)
                continue
                ;;
        esac
        EXTRA_CONFIGS="$EXTRA_CONFIGS $f"
    done

    # Generate runtime override for [openrfid_api] enable_write based on the
    # extended2.cfg [components] rfid_write toggle. The override file is
    # included LAST so its values win over the static openrfid_api.cfg
    # shipped by the SPA overlay. Only emitted when the toggle is true so
    # the safe default (writes disabled) stands when the key is absent.
    rm -f "$API_OVERRIDE_CFG"
    RFID_WRITE=$(/usr/local/bin/extended-config.py get "$EXTENDED2_CFG" components rfid_write false 2>/dev/null)
    if [ "$RFID_WRITE" = "true" ]; then
        cat >"$API_OVERRIDE_CFG" <<'EOF'
[openrfid_api]
enable_write = true
EOF
        EXTRA_CONFIGS="$EXTRA_CONFIGS $API_OVERRIDE_CFG"
    fi

    printf "Starting OpenRFID: "
    start-stop-daemon -S -b -m \
        -p "$PIDFILE" \
        -x /usr/bin/python3 -- /usr/local/bin/openrfid.py \
        /tmp/openrfid.cfg \
        /usr/local/share/openrfid/extended/openrfid_u1_base.cfg \
        $DETECT_CONFIG \
        $ADDITIONAL_CONFIG \
        $EXTRA_CONFIGS
    echo "OK"
}

stop() {
    printf "Stopping OpenRFID: "
    if [ -f "$PIDFILE" ]; then
        start-stop-daemon -K -p "$PIDFILE" -s TERM
        rm -f "$PIDFILE"
        echo "OK"
    else
        echo "not running"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        sleep 1
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
