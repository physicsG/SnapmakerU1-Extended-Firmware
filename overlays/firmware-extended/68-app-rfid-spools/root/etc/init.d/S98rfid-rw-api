#!/bin/sh

DAEMON="/usr/local/bin/rfid-rw.py"
PIDFILE="/var/run/rfid-rw-api.pid"
LOGFILE="/tmp/rfid-rw-api.log"

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "rfid-rw-api already running"
        return 0
    fi

    printf "Starting rfid-rw-api: "
    start-stop-daemon -S -b -m \
        -p "$PIDFILE" \
        -x /usr/bin/python3 -- "$DAEMON" serve \
        >>"$LOGFILE" 2>&1

    echo "OK"
}

stop() {
    printf "Stopping rfid-rw-api: "
    if [ -f "$PIDFILE" ]; then
        start-stop-daemon -K -p "$PIDFILE" -s TERM
        rm -f "$PIDFILE"
        echo "OK"
    else
        echo "not running"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        sleep 1
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
